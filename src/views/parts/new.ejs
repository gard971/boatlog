<%- include("../partials/head", { title: "Ny del" }) %>

<section class="card">
  <h1>Ny del</h1>
  <form method="post" action="/parts">
    <label>Navn</label>
    <input name="name" required />

    <label>Artikkelnummer (SKU)</label>
    <input name="sku" />

    <label>Leverandør</label>
    <input name="supplier" />

    <label>Standard pris (NOK)</label>
    <input name="priceNok" type="number" step="0.01" min="0" placeholder="f.eks. 289.00" />

    <label>Notater</label>
    <textarea name="notes" rows="4"></textarea>

    <button class="button primary" type="submit">Lagre del</button>
  </form>
</section>

<%- include("../partials/foot") %>
