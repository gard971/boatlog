<%- include("../partials/head", { title: "Service" }) %>

<section class="card">
  <div class="row">
    <h1>Service</h1>
    <a class="button primary" href="/service/new">+ Nytt servicepunkt</a>
  </div>

  <p class="muted">
    Vis: <a href="/service?days=30">30</a> · <a href="/service?days=60">60</a> · <a href="/service?days=90">90</a> dager
  </p>
</section>

<section class="card">
  <h2>Forfalt</h2>
  <% if (overdue.length === 0) { %>
    <p class="muted">Ingen forfalte servicepunkter 🎉</p>
  <% } else { %>
    <ul class="list">
      <% overdue.forEach(t => { %>
        <li class="list-item">
          <div>
            <a href="/todos/<%= t.id %>"><%= t.title %></a>
            <span class="muted">
              · Forfall: <%= new Date(t.dueAt).toLocaleDateString("no-NO") %>
              <%= t.cycleNumber ? "· #" + t.cycleNumber : "" %>
            </span>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="card">
  <h2>Forfaller innen <%= days %> dager</h2>
  <% if (dueSoon.length === 0) { %>
    <p class="muted">Ingen kommende servicepunkter.</p>
  <% } else { %>
    <ul class="list">
      <% dueSoon.forEach(t => { %>
        <li class="list-item">
          <div>
            <a href="/todos/<%= t.id %>"><%= t.title %></a>
            <span class="muted">
              · Forfall: <%= new Date(t.dueAt).toLocaleDateString("no-NO") %>
              <%= t.cycleNumber ? "· #" + t.cycleNumber : "" %>
            </span>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include("../partials/foot") %>
