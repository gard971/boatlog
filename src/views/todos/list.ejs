<%- include("../partials/head", { title: "Oppgaver" }) %>

<section class="card">
  <div class="row">
    <h1>Oppgaver</h1>
    <a class="button" href="/todos/new">+ Ny oppgave</a>
  </div>

  <table class="table">
    <table class="table">
  <thead>
    <tr>
      <th>Tittel</th>
      <th>Status</th>
      <th>Ferdig</th>
      <th>Neste forfall</th>
    </tr>
  </thead>

  <tbody>
    <% todos.forEach(t => { %>
      <tr>
        <td><a href="/todos/<%= t.id %>"><%= t.title %></a></td>
        <td><%= t.status %></td>
        <td><%= t.completedAt ? new Date(t.completedAt).toLocaleDateString("no-NO") : "-" %></td>
        <td><%= t.nextDueAt ? new Date(t.nextDueAt).toLocaleDateString("no-NO") : "-" %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

</section>

<%- include("../partials/foot") %>
