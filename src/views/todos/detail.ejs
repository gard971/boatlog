<%- include("../partials/head", { title: "Oppgave" }) %>

<section class="card">
  <div class="row">
    <div>
      <h1><%= todo.title %></h1>
      <% if (todo.description) { %>
        <p class="muted"><%= todo.description %></p>
      <% } %>

      <p class="muted">
        Opprettet: <%= new Date(todo.createdAt).toLocaleString("no-NO") %>
        <% if (todo.completedAt) { %> · Ferdig: <%= new Date(todo.completedAt).toLocaleString("no-NO") %><% } %>
      </p>
    </div>

    <form method="post" action="/todos/<%= todo.id %>/toggle?_method=PUT">
      <button class="button <%= todo.status === "DONE" ? "danger" : "primary" %>" type="submit">
        <%= todo.status === "DONE" ? "Marker som Å gjøre" : "Marker som Ferdig" %>
      </button>
    </form>
  </div>
</section>

<section class="card">
  <h2>Knyttet til problemer</h2>
  <% if (todo.issues.length === 0) { %>
    <p class="muted">Denne oppgaven er ikke knyttet til et problem enda.</p>
  <% } else { %>
    <ul class="list">
      <% todo.issues.forEach(it => { %>
        <li class="list-item">
          <a href="/issues/<%= it.issue.id %>"><%= it.issue.title %></a>
          <span class="muted">· <%= it.issue.status === "OPEN" ? "Åpen" : it.issue.status === "INVESTIGATE" ? "Må finne årsak" : "Løst" %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<section class="card">
  <h2>Deler brukt</h2>

  <% if (todo.parts.length === 0) { %>
    <p class="muted">Ingen deler registrert på denne oppgaven.</p>
  <% } else { %>
    <ul class="list">
      <% todo.parts.forEach(u => { %>
        <li class="list-item">
          <div>
            <strong><%= u.part.name %></strong>
            <span class="muted">· x<%= u.quantity %> · <%= u.part.sku || "" %> <%= u.part.supplier ? "· " + u.part.supplier : "" %></span>
          </div>
          <form method="post" action="/parts/use/remove">
            <input type="hidden" name="todoId" value="<%= todo.id %>" />
            <input type="hidden" name="partId" value="<%= u.part.id %>" />
            <button class="button danger" type="submit">Fjern</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <hr/>

  <h3>Legg til del</h3>
  <form method="post" action="/parts/use">
    <input type="hidden" name="todoId" value="<%= todo.id %>" />
    <label>Velg del</label>
    <select name="partId" required>
      <option value="" disabled selected>-- Velg del --</option>
      <% allParts.forEach(p => { %>
        <option value="<%= p.id %>"><%= p.name %> <%= p.sku ? "(" + p.sku + ")" : "" %></option>
      <% }) %>
    </select>

    <label>Antall</label>
    <input name="quantity" type="number" min="1" value="1" />

    <button class="button primary" type="submit">Legg til</button>
  </form>

  <p class="muted">Mangler du delen? <a href="/parts/new">Registrer ny del</a>.</p>
</section>

<section class="card">
  <h2>Vedlegg</h2>

  <form method="post" action="/attachments/todo/<%= todo.id %>" enctype="multipart/form-data">
    <input type="file" name="file" required />
    <button class="button" type="submit">Last opp</button>
  </form>

  <% if (todo.attachments.length === 0) { %>
    <p class="muted">Ingen vedlegg enda.</p>
  <% } else { %>
    <ul class="list">
      <% todo.attachments.forEach(a => { %>
        <li class="attachment">
  <div class="attachment-preview">

    <% if (a.mimeType.startsWith("image/")) { %>
      <a href="<%= a.storagePath %>" target="_blank">
        <img src="<%= a.storagePath %>" class="thumb"/>
      </a>

    <% } else if (a.mimeType === "application/pdf") { %>
      <iframe src="<%= a.storagePath %>" class="pdf"></iframe>

    <% } else if (a.mimeType.startsWith("video/")) { %>
      <video controls class="video">
        <source src="<%= a.storagePath %>" type="<%= a.mimeType %>">
      </video>

    <% } else { %>
      <div class="filebox">
        📄 <a href="<%= a.storagePath %>" target="_blank"><%= a.originalName %></a>
      </div>
    <% } %>

  </div>

  <div class="attachment-meta">
    <span class="muted">
      <%= new Date(a.uploadedAt).toLocaleString("no-NO") %>
    </span>

    <form method="post" action="/attachments/<%= a.id %>?_method=DELETE">
      <button class="button danger" type="submit">Slett</button>
    </form>
  </div>
</li>

      <% }) %>
    </ul>
  <% } %>
</section>

<%- include("../partials/foot") %>
