generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  OPEN
  INVESTIGATE
  RESOLVED
}

enum TodoStatus {
  TODO
  DONE
}

enum AttachmentTargetType {
  ISSUE
  TODO
}

model Issue {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  resolvedAt  DateTime?

  todos       IssueTodo[]
  attachments Attachment[]
}

model Todo {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TodoStatus    @default(TODO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?
  intervalDays Int?    
  nextDueAt    DateTime? 


  issues      IssueTodo[]
  attachments Attachment[]
  parts PartUsage[]
}

model IssueTodo {
  issueId String
  todoId  String

  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  todo    Todo  @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@id([issueId, todoId])
}

model Attachment {
  id          String               @id @default(cuid())
  targetType  AttachmentTargetType
  issueId     String?
  todoId      String?

  originalName String
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  uploadedAt   DateTime @default(now())

  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  todo  Todo?  @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([todoId])
}
model Part {
  id           String   @id @default(cuid())
  name         String
  sku          String?  // artikkelnummer
  supplier     String?  // Biltema, Maritim, osv
  priceNok     Int?     // lagre i øre (NOK * 100) for å slippe desimal-krøll
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usages       PartUsage[]
}

model PartUsage {
  id        String   @id @default(cuid())
  partId    String
  todoId    String
  quantity  Int      @default(1)
  priceNok  Int?     // pris på akkurat denne jobben (overstyrer part.priceNok)
  createdAt DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([todoId])
  @@unique([partId, todoId]) // en part per todo (med quantity)
}
